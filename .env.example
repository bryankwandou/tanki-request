# --- Database (MySQL) ---
# `allowPublicKeyRetrieval=true` HANYA untuk MySQL 8 lokal tanpa TLS: akun
# MySQL 8 memakai caching_sha2_password, dan tanpa opsi ini container yang
# baru di-restart menolak semua koneksi ("RSA public key is not available").
# Di produksi: pakai TLS ke database dan HAPUS opsi ini.
DATABASE_URL="mysql://tanki:password@127.0.0.1:3306/tanki_jene?allowPublicKeyRetrieval=true"

# --- Auth.js (NextAuth v5) ---
# openssl rand -base64 32
AUTH_SECRET="AUTH_SECRET"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Keycloak (realm DIAMOND, client tanki-jene) ---
AUTH_KEYCLOAK_ID="tanki-jene"
AUTH_KEYCLOAK_SECRET="KEYCLOAK_CLIENT_SECRET"
AUTH_KEYCLOAK_ISSUER="https://diamond.pdammakassar.co.id/auth/realms/DIAMOND"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Tautan lacak bertanda tangan (Issue #6) ---
# Kunci HMAC untuk menandatangani tautan lacak yang dikirim lewat email.
# Boleh dikosongkan: bila kosong, AUTH_SECRET yang dipakai.
# Mengganti kunci ini membuat seluruh tautan yang sudah beredar tidak berlaku.
TRACKING_LINK_SECRET=""

# --- Enkripsi rahasia di tabel konfigurasi (Issue #7) ---
# Kunci AES-256 (32 byte, base64) untuk mengenkripsi password SMTP sebelum
# masuk database:
#   openssl rand -base64 32
#
# Kunci ini TIDAK BOLEH ikut ke database maupun ke dump .sql — di situlah
# gunanya: siapa pun yang memegang salinan dump tidak ikut memegang kuncinya.
# Tanpa kunci ini, password SMTP tidak bisa disimpan (form konfigurasi akan
# menolak dengan pesan yang jelas), dan yang sudah tersimpan tidak bisa dibaca
# sehingga pengiriman email dinonaktifkan.
#
# Mengganti kunci membuat password lama tak terbaca — setelah rotasi, isi ulang
# password SMTP lewat /dashboard/konfigurasi.
CONFIG_ENCRYPTION_KEY=""

# Cetak isi email OTP ke stdout saat development (default: tidak).
# Hanya berlaku bila NODE_ENV != production. Normalnya tidak perlu: docker
# compose sudah menyediakan Mailpit, baca kodenya di http://localhost:8025
OTP_DEBUG_LOG=""

# --- Rate Limiter (FR-08) ---
# Jumlah hop reverse-proxy TEPERCAYA di depan aplikasi. Aplikasi hanya mempercayai
# sebanyak ini entri terakhir (paling kanan) dari X-Forwarded-For; apa pun di
# sebelah kiri batas itu dianggap kiriman klien dan tidak dipakai.
#
#   1 = satu Nginx / satu load balancer / Vercel   (default)
#   2 = CDN di depan Nginx
#
# SALAH SET ITU BERBAHAYA: nilai yang terlalu besar membuat aplikasi memercayai
# entri yang sebenarnya ditulis klien → rate limit bisa dilewati dengan memalsukan
# header. Hitung hop yang benar-benar ada di jalur produksi, jangan menebak.
TRUSTED_PROXY_COUNT="1"

# Redis URL untuk rate limiter multi-instance (opsional).
# Jika tidak diset, pakai in-memory LRU (reset saat restart, tidak cocok untuk multi-pod).
# Contoh Upstash: rediss://:password@host:6380
# Contoh lokal:   redis://localhost:6379
REDIS_URL=""
