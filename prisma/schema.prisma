generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Master data pelanggan (read-only). Diimpor dari pelanggan.sql (~231k baris).
// JANGAN ditulis dari aplikasi — hanya validasi & auto-fill / pencarian.
// Tabel dibuat lewat db/pelanggan_ddl.sql lalu di-baseline ke Prisma.
// ---------------------------------------------------------------------------
model Pelanggan {
  nosamb    String  @id @db.Char(9)
  nama      String  @db.VarChar(150)
  alamat    String? @db.VarChar(255)
  koderayon String? @db.VarChar(7)
  wil       String? @db.Char(2)

  @@index([nama], map: "idx_pelanggan_nama")
  @@index([koderayon], map: "idx_pelanggan_koderayon")
  @@index([wil], map: "idx_pelanggan_wil")
  @@map("pelanggan")
}

// ---------------------------------------------------------------------------
// Transaksi
// ---------------------------------------------------------------------------
enum StatusTiket {
  DITERIMA
  TERVERIFIKASI
  DIJADWALKAN
  DALAM_PERJALANAN
  SELESAI
  DITOLAK
  DIBATALKAN
}

enum ArmadaStatus {
  TERSEDIA
  BERTUGAS
  PERBAIKAN
  NONAKTIF
}

enum SopirStatus {
  TERSEDIA
  BERTUGAS
  CUTI
  NONAKTIF
}

enum PenugasanStatus {
  DIJADWALKAN
  BERANGKAT
  SELESAI
  DIBATALKAN
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum NotifJenis {
  OTP
  TIKET
  UPDATE
  // Email percobaan dari halaman konfigurasi. Dipisah supaya uji coba admin
  // tidak bercampur dengan notifikasi tiket di log audit (FR-20/21).
  TES
}

enum KirimStatus {
  TERKIRIM
  GAGAL
  // Tidak ada email yang benar-benar keluar — jalur fallback console saat SMTP
  // belum dikonfigurasi (khusus non-produksi). Dicatat terpisah supaya log
  // audit tidak mengklaim "TERKIRIM" untuk email yang tidak pernah ada.
  DILEWATI
}

model Tiket {
  id             BigInt      @id @default(autoincrement())
  noTiket        String      @unique @map("no_tiket") @db.VarChar(30)
  noPelanggan    String      @map("no_pelanggan") @db.Char(9)
  namaSnapshot   String?     @map("nama_snapshot") @db.VarChar(150)
  alamatSnapshot String?     @map("alamat_snapshot") @db.VarChar(255)
  wil            String?     @db.Char(2)
  koderayon      String?     @map("koderayon") @db.VarChar(7)
  noHp           String      @map("no_hp") @db.VarChar(20)
  email          String?     @db.VarChar(150)
  keluhan        String      @db.Text
  status         StatusTiket @default(DITERIMA)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  riwayat    TiketRiwayat[]
  penugasan  Penugasan[]
  notifikasi NotifikasiLog[]

  @@index([status])
  @@index([noPelanggan])
  @@index([noHp])
  /// Query utama modul Laporan (Issue #1): range scan `created_at`, lalu
  /// dikelompokkan per status / wilayah / rayon. Dengan index single-column
  /// `created_at` saja, pengelompokannya jatuh ke filesort — tidak terasa
  /// sekarang, tapi tabel ini justru yang paling sering discan seiring tumbuh.
  ///
  /// `created_at` tetap menjadi kolom paling kiri, jadi kedua index ini juga
  /// melayani seluruh query yang dulu memakai `@@index([createdAt])` —
  /// karenanya index tunggal itu dihapus, bukan ditambahi.
  @@index([createdAt, status])
  @@index([createdAt, wil, koderayon])
  @@map("tiket")
}

model TiketRiwayat {
  id           BigInt      @id @default(autoincrement())
  tiketId      BigInt      @map("tiket_id")
  tiket        Tiket       @relation(fields: [tiketId], references: [id], onDelete: Cascade)
  status       StatusTiket
  catatan      String?     @db.Text
  /// Apakah `catatan` boleh dilihat pelapor di /lacak (Issue #6).
  /// Default false: catatan operator bersifat internal kecuali dinyatakan
  /// sebaliknya, sehingga baris lama tetap tersembunyi setelah migrasi.
  catatanPublik Boolean    @default(false) @map("catatan_publik")
  operatorId   String?     @map("operator_id") @db.VarChar(64)
  operatorNama String?     @map("operator_nama") @db.VarChar(150)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([tiketId])
  @@map("tiket_riwayat")
}

model OtpVerifikasi {
  id          BigInt    @id @default(autoincrement())
  // Identitas yang dipegang klien selama alur OTP. Sengaja BUKAN `id`:
  // id bersifat sequential, jadi penyerang bisa menebak/menghitung otpId milik
  // orang lain dan menyerang permintaan yang bukan miliknya. 32 byte acak
  // (base64url) tidak bisa ditebak. Lihat Issue #4.
  token       String    @unique @db.VarChar(64)
  /// SHA-256 dari secret yang hanya ada di cookie HttpOnly milik browser
  /// pemohon — lapis kedua di atas `token` (Issue #4).
  ///
  /// `token` adalah capability token: siapa pun yang memegangnya boleh
  /// bertindak. Itu cukup melawan enumerasi, tapi tidak melawan token yang
  /// bocor lewat jalur lain — Referer, log proxy, riwayat peramban, layar yang
  /// terlihat orang lain. Dengan kolom ini, token saja tidak cukup: penyerang
  /// juga harus memegang cookie yang tidak pernah terbaca JavaScript dan tidak
  /// pernah ikut di URL.
  ///
  /// Nullable supaya baris yang dibuat sebelum kolom ini ada tetap bisa
  /// diselesaikan pemiliknya; baris baru selalu mengisinya.
  sessionHash String?   @map("session_hash") @db.VarChar(64)
  noPelanggan String    @map("no_pelanggan") @db.Char(9)
  email       String    @db.VarChar(150)
  noHp        String    @map("no_hp") @db.VarChar(20)
  keluhan     String    @db.Text
  kodeHash    String    @map("kode_hash") @db.VarChar(255)
  expiredAt   DateTime  @map("expired_at")
  // Percobaan verifikasi GAGAL sepanjang umur permintaan ini. Sengaja TIDAK
  // di-reset saat kirim ulang — reset itulah yang membuat cap-nya bisa dilewati
  // (Issue #4): 5 tebakan, kirim ulang, 5 tebakan lagi, tanpa batas.
  attempts    Int       @default(0)
  // Berapa kali kode dikirim ulang untuk permintaan ini, dibatasi di server.
  resendCount Int       @default(0) @map("resend_count")
  // Waktu pengiriman kode terakhir, untuk jeda antar kirim ulang.
  lastSentAt  DateTime  @default(now()) @map("last_sent_at")
  status      OtpStatus @default(PENDING)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([noPelanggan, status])
  @@index([email, status])
  @@map("otp_verifikasi")
}

model Konfigurasi {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedBy String?  @map("updated_by") @db.VarChar(64)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("konfigurasi")
}

model NotifikasiLog {
  id          BigInt      @id @default(autoincrement())
  tiketId     BigInt?     @map("tiket_id")
  tiket       Tiket?      @relation(fields: [tiketId], references: [id], onDelete: SetNull)
  channel     String      @default("EMAIL") @db.VarChar(20)
  jenis       NotifJenis
  tujuan      String      @db.VarChar(150)
  statusKirim KirimStatus @map("status_kirim")
  error       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([tiketId])
  @@map("notifikasi_log")
}

model Kendaraan {
  id             BigInt       @id @default(autoincrement())
  nopol          String       @unique @db.VarChar(20)
  merk           String?      @db.VarChar(100)
  kapasitasLiter Int?         @map("kapasitas_liter")
  status         ArmadaStatus @default(TERSEDIA)
  aktif          Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  penugasan Penugasan[]

  @@map("kendaraan")
}

model Sopir {
  id        BigInt      @id @default(autoincrement())
  nama      String      @db.VarChar(150)
  nik       String?     @unique @db.VarChar(30)
  noHp      String?     @map("no_hp") @db.VarChar(20)
  status    SopirStatus @default(TERSEDIA)
  aktif     Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  penugasan Penugasan[]

  @@map("sopir")
}

model Penugasan {
  id            BigInt          @id @default(autoincrement())
  tiketId       BigInt          @map("tiket_id")
  tiket         Tiket           @relation(fields: [tiketId], references: [id])
  kendaraanId   BigInt          @map("kendaraan_id")
  kendaraan     Kendaraan       @relation(fields: [kendaraanId], references: [id])
  sopirId       BigInt          @map("sopir_id")
  sopir         Sopir           @relation(fields: [sopirId], references: [id])
  jadwalMulai   DateTime        @map("jadwal_mulai")
  jadwalSelesai DateTime?       @map("jadwal_selesai")
  status        PenugasanStatus @default(DIJADWALKAN)
  assignedBy    String?         @map("assigned_by") @db.VarChar(64)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // Catatan: anti double-booking ditegakkan lewat generated column + UNIQUE key
  // di MySQL (lihat db/penugasan_guard.sql), tidak dapat diekspresikan di Prisma.
  @@index([kendaraanId])
  @@index([sopirId])
  @@index([tiketId])
  @@map("penugasan")
}
